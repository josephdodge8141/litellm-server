# ── LiteLLM Master Key (required) ──
# Generate with: openssl rand -hex 16 && echo "sk-$(cat)"
# All clients must send: Authorization: Bearer <LITELLM_MASTER_KEY>
LITELLM_MASTER_KEY=sk-litellm-local-dev

# ── Bedrock Auth — pick ONE ──
# Option A: Bedrock API key (recommended, long-term service-specific credential)
# Created via: aws iam create-service-specific-credential --user-name litellm-bedrock --service-name bedrock.amazonaws.com
# Value looks like: ABSKQmVkcm9ja0FQSUtleS...
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Option B: IAM access keys (if not using bearer token)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Postgres (for UI / key storage / spend logs) ──
# Litellm UI login ("Not connected to DB" otherwise) requires DATABASE_URL.
# Defaults below are fine for local; override if you want different creds.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm
POSTGRES_DB=litellm

# ── Redis (for rate limits / budgets / router state / cache) ──
# Without Redis each uvicorn worker keeps its own state → limits overshoot.
# The banner "No Redis configured" means you are in that mode.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

